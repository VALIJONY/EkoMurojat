# Nusxa oling:  cp .env.example .env
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL + PostGIS
DB_NAME=ekomurojat
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Tasdiqlash kodi uchun SMTP (ixtiyoriy).
# EMAIL_HOST_USER berilmasa, kod terminalga chiqadi.
# Gmail uchun oddiy parol emas, "ilova paroli" (App password) kerak.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
